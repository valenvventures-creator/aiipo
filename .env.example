# Thought Authorities A.I. IPO - environment variables.
# On Netlify, set these under Site configuration -> Environment variables. Never commit real values.

# Provided automatically by Netlify when Netlify Database is enabled for the site.
# NETLIFY_DB_URL=

# Email via Resend (same names as the other Thought Authorities sites). Optional.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Thought Authorities <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# auto (default): require email verification only when email is configured. Or: required / off
EMAIL_VERIFICATION=auto

# Optional: Claude-powered A.I. guide (rule-based without it)
ANTHROPIC_API_KEY=

# Optional: your own 32-byte base64 encryption key (npm run keygen). If unset on Netlify, one is generated
# once and stored in a private Netlify Blobs store. Never change it once data exists.
TA_MASTER_KEY=

# Optional: extra site addresses allowed to submit forms (Netlify deploy previews are allowed automatically)
ALLOWED_ORIGINS=
