# Copy to your secret manager / deployment environment. Never commit real values.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
BASE_URL=https://ipo.example.com
# 32-byte base64 key from `npm run keygen`. Losing it makes encrypted data unrecoverable.
TA_MASTER_KEY=
TRUST_PROXY=true
DATABASE_PATH=/var/lib/ta-ipo/ta-ipo.sqlite
UPLOAD_DIR=/var/lib/ta-ipo/objects
# Transactional email provider webhook (receives {from,to,subject,text} JSON with Bearer token)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=Thought Authorities <no-reply@example.com>
# Optional: enables the Claude-powered A.I. guide (otherwise rule-based)
ANTHROPIC_API_KEY=
# auto (default): require email verification only when MAIL_WEBHOOK_URL is set. Or: required / off
EMAIL_VERIFICATION=auto
# Extra site addresses allowed to submit forms, e.g. a Netlify site that forwards to this server
ALLOWED_ORIGINS=
